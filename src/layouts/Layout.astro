---
import '@styles/main.css';
import { Font, type CssVariable } from 'astro:assets';
import { SEO } from 'astro-seo';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { resolveSeo, type SanitySeo } from '@lib/sanity/seo';
import { visualEditingEnabled } from '@lib/sanity/loadQuery';

interface Props {
    /** Fallback title when the page hasn't set one in the Studio. */
    title?: string | null;
    seo?: SanitySeo;
    defaultSeo?: SanitySeo;
    siteName?: string | null;
}

const { title = null, seo = null, defaultSeo = null, siteName = null } = Astro.props;

// Astro's directory build format gives `/work/`, but the URL people land on and
// that ends up in the sitemap is `/work` — so the canonical has to match.
const canonicalPath = Astro.url.pathname.replace(/(.)\/$/, '$1');

const seoData = resolveSeo({
    seo,
    defaults: defaultSeo,
    fallbackTitle: title,
    siteName,
    canonical: new URL(canonicalPath, Astro.site ?? Astro.url.origin).href
});

// Constants
const FONTS: CssVariable[] = ['--custom-font-sans'];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        {
            /* Hide page before first paint when scroll restoration is pending,
            to prevent the hero logo flashing on refresh. Revealed in Scroll.ts. */
        }
        <script is:inline>
            if (sessionStorage.getItem('app:scrollY')) {
                document.documentElement.style.visibility = 'hidden';
            }
        </script>

        <SEO {...seoData} />

        {FONTS.map((font) => <Font cssVariable={font} preload />)}
    </head>
    <body>
        <script src="../scripts/app.ts"></script>
        <main id="swup" class="transition-fade">
            <div id="content">
                <slot />
            </div>
        </main>
        <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
    </body>
</html>
