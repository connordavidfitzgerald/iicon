---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar/Navbar.astro';
import Footer from '@components/Footer/Footer.astro';
import { loadQuery } from '@lib/sanity/loadQuery';
import { CONTACT_PAGE_QUERY, SITE_SETTINGS_QUERY } from '@lib/sanity/queries';
import type { CONTACT_PAGE_QUERY_RESULT, SITE_SETTINGS_QUERY_RESULT } from '@root/sanity.types';

const [page, settings] = await Promise.all([
    loadQuery<CONTACT_PAGE_QUERY_RESULT>({ query: CONTACT_PAGE_QUERY }),
    loadQuery<SITE_SETTINGS_QUERY_RESULT>({ query: SITE_SETTINGS_QUERY })
]);
---

<Layout
    title="Contact Us"
    seo={page?.seo}
    defaultSeo={settings?.defaultSeo}
    siteName={settings?.siteName}
>
    <Navbar links={settings?.navLinks} cta={settings?.navCta} />
    <Footer
        headline={settings?.footerHeadline}
        email={settings?.email}
        phone={settings?.phone}
        form={settings?.form}
    />
</Layout>
