---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar/Navbar.astro';
import Footer from '@components/Footer/Footer.astro';
import { loadQuery } from '@lib/sanity/loadQuery';
import { SITE_SETTINGS_QUERY } from '@lib/sanity/queries';
import type { SITE_SETTINGS_QUERY_RESULT } from '@root/sanity.types';

const settings = await loadQuery<SITE_SETTINGS_QUERY_RESULT>({ query: SITE_SETTINGS_QUERY });
---

<Layout
    title="Page not found"
    seo={{ hideFromSearch: true }}
    defaultSeo={settings?.defaultSeo}
    siteName={settings?.siteName}
>
    <Navbar links={settings?.navLinks} cta={settings?.navCta} />
    <div
        class="flex h-fit w-full flex-col gap-fluid-twenty pt-fluid-160 pr-fluid-twenty pb-fluid-160 pl-fluid-twenty"
    >
        <h1 class="text-heading-lg leading-[115%] font-normal tracking-[-3%] text-black">
            That page doesn't exist.
        </h1>
        <a class="hover-underline w-fit text-body-sm tracking-[-1%]" href="/work"
            >See all projects ↗</a
        >
    </div>
    <Footer
        headline={settings?.footerHeadline}
        email={settings?.email}
        phone={settings?.phone}
        form={settings?.form}
    />
</Layout>
