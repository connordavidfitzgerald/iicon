---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar/Navbar.astro';
import Footer from '@components/Footer/Footer.astro';
import PortableText from '@components/PortableText/PortableText.astro';
import { loadQuery } from '@lib/sanity/loadQuery';
import { ABOUT_PAGE_QUERY, SITE_SETTINGS_QUERY } from '@lib/sanity/queries';
import type { ABOUT_PAGE_QUERY_RESULT, SITE_SETTINGS_QUERY_RESULT } from '@root/sanity.types';

const [page, settings] = await Promise.all([
    loadQuery<ABOUT_PAGE_QUERY_RESULT>({ query: ABOUT_PAGE_QUERY }),
    loadQuery<SITE_SETTINGS_QUERY_RESULT>({ query: SITE_SETTINGS_QUERY })
]);
---

<Layout
    title="About Us"
    seo={page?.seo}
    defaultSeo={settings?.defaultSeo}
    siteName={settings?.siteName}
>
    <div class="relative flex h-screen flex-col">
        <div class="fixed top-0 right-0 left-0 z-50 h-fit bg-black">
            <Navbar links={settings?.navLinks} cta={settings?.navCta} />
        </div>
        <div
            class="flex h-fit w-full flex-col justify-start gap-fluid-eighty bg-white pt-fluid-270 pr-fluid-twenty pb-fluid-eighty pl-fluid-twenty sm:pt-fluid-160"
        >
            <div class="grid grid-cols-12 gap-fluid-twenty">
                <h3
                    class="col-span-12 hidden h-fit text-body-sm font-normal tracking-[-0.01em] text-black xs:col-span-4 xs:flex"
                >
                    {page?.introLabel}
                </h3>
                <p
                    class="col-span-12 h-fit w-full pt-2 text-heading-lg leading-[112%] font-medium tracking-[-0.018em] text-black/90 xs:col-span-8"
                >
                    {page?.intro}
                </p>
            </div>

            <div class="grid grid-cols-12 gap-fluid-twenty">
                <h3
                    class="col-span-12 h-fit text-body-sm font-normal tracking-[-0.01em] text-black xs:col-span-4"
                >
                    {page?.valuesLabel}
                </h3>
                {
                    page?.values?.map((column) => (
                        <div class="wysiwyg col-span-12 h-fit pt-2 text-body-caption leading-[120%] font-normal tracking-[-0.01em] text-black/90 xs:col-span-4">
                            <PortableText value={column.body} />
                        </div>
                    ))
                }
            </div>

            <div class="grid grid-cols-12 gap-fluid-twenty">
                <h3
                    class="col-span-12 h-fit text-body-sm font-normal tracking-[-2%] text-black xs:col-span-4"
                >
                    {page?.contactLabel}
                </h3>
                <div
                    class="col-span-8 grid h-fit grid-cols-2 gap-fluid-twenty pt-2 text-nav leading-[110%] font-normal tracking-[-1%] text-black/90"
                >
                    <div class="col-span-2 flex flex-row gap-fluid-forty xs:col-span-1">
                        <a class="hover-underline" href={`mailto:${settings?.email}`}
                            >{settings?.email}</a
                        >
                        <a
                            class="hover-underline"
                            href={`tel:${(settings?.phone ?? '').replace(/[^+\d]/g, '')}`}
                            >{settings?.phone}</a
                        >
                    </div>
                    <div class="col-span-2 flex flex-row gap-fluid-forty xs:col-span-1">
                        {
                            settings?.socialLinks?.map((social) => (
                                <a
                                    class="hover-underline"
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {social.label}
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

        <Footer
            headline={settings?.footerHeadline}
            email={settings?.email}
            phone={settings?.phone}
            form={settings?.form}
        />
    </div>
</Layout>

<style>
    /* Paragraphs inside the values columns keep the original blank-line rhythm. */
    .wysiwyg :global(p + p) {
        margin-top: 1.5em;
    }
</style>
