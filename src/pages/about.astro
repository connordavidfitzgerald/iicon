---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar/Navbar.astro';
import SplitReveal from '@components/SplitReveal/SplitReveal.astro';
import Button from '@components/Button/Button.astro';
import Footer from '@components/Footer/Footer.astro';
---

<Layout
    title="About Us | IICON Creative Strategies"
    seo={{
        description:
            'Learn about the values and approach of IICON Creative Strategies, a responsible promotional products supplier.'
    }}
>
    <div class="relative flex h-screen flex-col">
        <div class="fixed top-0 right-0 left-0 z-50 h-fit bg-black">
            <Navbar />
        </div>
        <div
            class="flex h-fit w-full flex-col justify-start gap-fluid-eighty bg-white pt-fluid-270 pr-fluid-twenty pb-fluid-eighty pl-fluid-twenty sm:pt-fluid-160"
        >
            <div class="grid grid-cols-12 gap-fluid-twenty">
                <h3
                    class="col-span-12 hidden h-fit text-body-sm font-normal tracking-[-0.01em] text-black xs:col-span-4 xs:flex"
                >
                    Information
                </h3>
                <p
                    class="col-span-12 h-fit w-full pt-2 text-heading-lg leading-[112%] font-medium tracking-[-0.018em] text-black/90 xs:col-span-8"
                >
                    IICON Creative Strategies is a specialist branding studio that combines
                    strategic thinking with the science of human connection. We source merchandise
                    responsibly, design with cultural and psychological intention, and partner with
                    clients who share our commitment to quality and ethical practice. As a minority
                    woman-owned and Canadian company, we are selective yet comprehensive—delivering
                    branded work that earns its place in people's lives.
                </p>
            </div>

            <div class="grid grid-cols-12 gap-fluid-twenty">
                <h3
                    class="col-span-12 h-fit text-body-sm font-normal tracking-[-0.01em] text-black xs:col-span-4"
                >
                    Our Values
                </h3>
                <p
                    class="col-span-12 h-fit pt-2 text-body-caption leading-[120%] font-normal tracking-[-0.01em] text-black/90 xs:col-span-4"
                >
                    The products we choose, the suppliers we partner with, and the standards we hold
                    ourselves to are all rooted in the same values: sustainability, ethics, and
                    responsibility. We focus on products that are sustainably sourced, ethically
                    made, and built to last.<br /><br />Quality and responsibility go hand in hand,
                    and the best way to reduce waste is to create things people actually want to
                    keep.
                </p>
                <p
                    class="col-span-12 h-fit pt-2 text-body-caption leading-[120%] font-normal tracking-[-0.01em] text-black/90 xs:col-span-4"
                >
                    Every manufacturer in our network is held to strong ethical, social, and safety
                    standards, supported by third-party audits and environmental accountability.
                    Whether Made in Canada, Made in North America, or ethically sourced offshore, we
                    stand behind what we offer.<br /><br />
                    Our relationships — with clients and supplier partners — are our greatest asset. We
                    invest in them for the long term.
                </p>
            </div>

            <div class="grid grid-cols-12 gap-fluid-twenty">
                <h3
                    class="col-span-12 h-fit text-body-sm font-normal tracking-[-2%] text-black xs:col-span-4"
                >
                    Contact
                </h3>
                <div
                    class="col-span-8 grid h-fit grid-cols-2 gap-fluid-twenty pt-2 text-nav leading-[110%] font-normal tracking-[-1%] text-black/90"
                >
                    <div class="col-span-2 flex flex-row gap-fluid-forty xs:col-span-1">
                        <a class="hover-underline" href="mailto:rose@iicon.ca">rose@iicon.ca</a>
                        <a class="hover-underline" href="tel:+14165094715">+1 416 509 4715</a>
                    </div>
                    <div class="col-span-2 flex flex-row gap-fluid-forty xs:col-span-1">
                        <a
                            class="hover-underline"
                            href="https://www.instagram.com/iiconcreativestrategies"
                            target="_blank"
                            rel="noopener noreferrer">Instagram</a
                        >
                        <a
                            class="hover-underline"
                            href="https://www.facebook.com/profile.php?id=100063587556958"
                            target="_blank"
                            rel="noopener noreferrer">Facebook</a
                        >
                        <a
                            class="hover-underline"
                            href="https://ca.linkedin.com/company/iicon-creative-strategies-inc-"
                            target="_blank"
                            rel="noopener noreferrer">LinkedIn</a
                        >
                    </div>
                </div>
            </div>
        </div>

        <Footer />
    </div>
</Layout>
