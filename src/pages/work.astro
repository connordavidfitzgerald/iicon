---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar/Navbar.astro';
import Footer from '@components/Footer/Footer.astro';
import ProjectCard from '@components/ProjectCard/ProjectCard.astro';
import { loadQuery } from '@lib/sanity/loadQuery';
import { SITE_SETTINGS_QUERY, WORK_PAGE_QUERY } from '@lib/sanity/queries';
import type { SITE_SETTINGS_QUERY_RESULT, WORK_PAGE_QUERY_RESULT } from '@root/sanity.types';

const [page, settings] = await Promise.all([
    loadQuery<WORK_PAGE_QUERY_RESULT>({ query: WORK_PAGE_QUERY }),
    loadQuery<SITE_SETTINGS_QUERY_RESULT>({ query: SITE_SETTINGS_QUERY })
]);
---

<Layout
    title={page?.heading}
    seo={page?.seo}
    defaultSeo={settings?.defaultSeo}
    siteName={settings?.siteName}
>
    <Navbar links={settings?.navLinks} cta={settings?.navCta} />
    <div
        class="h-fit w-full pt-fluid-160 pr-fluid-twenty pb-fluid-twenty pl-fluid-twenty text-body-sm leading-[120%] tracking-[-3%]"
    >
        <h1>{page?.heading}</h1>
    </div>
    <div
        class="flex h-fit flex-col items-start gap-fluid-twenty pr-fluid-twenty pb-fluid-eighty pl-fluid-twenty md:grid md:grid-cols-12"
    >
        {page?.projects?.map((project) => <ProjectCard project={project} />)}
    </div>
    <Footer
        headline={settings?.footerHeadline}
        email={settings?.email}
        phone={settings?.phone}
        form={settings?.form}
    />
</Layout>
