---
import { Icon } from 'astro-icon/components';

interface Props {
    links?: { _key?: string; label?: string | null; href?: string | null }[] | null;
    cta?: { label?: string | null; href?: string | null } | null;
}

const { links = [], cta = null } = Astro.props;
---

<nav
    class="z-50 flex h-fit flex-row justify-between bg-white pt-fluid-fifteen pr-fluid-twenty pb-fluid-ten pl-fluid-twenty text-nav font-medium tracking-[-1%]"
>
    <div class="flex h-fit flex-row items-center justify-start gap-fluid-twenty">
        <a class="h-6 pr-fluid-ten pb-0.5 md:pr-0" href="/">
            <Icon name="iicon" class="pointer-events-auto h-full w-auto" />
        </a>
        <div class="flex h-fit flex-row justify-start gap-fluid-twenty pt-1.5 pb-0.5">
            {
                links?.map((link) => (
                    <a class="hover-underline" href={link.href}>
                        {link.label}
                    </a>
                ))
            }
        </div>
    </div>
    <div class="flex h-fit flex-row justify-end pt-1.5">
        {
            cta?.href && (
                <a class="hover-underline" href={cta.href}>
                    {cta.label}
                </a>
            )
        }
    </div>
</nav>
