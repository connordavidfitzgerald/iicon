---
import Button from '@components/Button/Button.astro';
import SplitRevealColour from '@components/SplitReveal/SplitRevealColour.astro';
import SplitReveal from '@components/SplitReveal/SplitReveal.astro';

interface Props {
    headline?: string | null;
    email?: string | null;
    phone?: string | null;
    form?: {
        nameLabel?: string | null;
        emailLabel?: string | null;
        messageLabel?: string | null;
        submitLabel?: string | null;
    } | null;
}

const { headline = null, email = null, phone = null, form = null } = Astro.props;

// The headline is authored as a textarea so the editor controls where it wraps.
const headlineLines = (headline ?? '').split('\n');
---

<div
    class="relative flex h-[800px] flex-col justify-between pr-fluid-twenty pb-fluid-forty pl-fluid-twenty"
>
    <div
        class="grid w-full grid-cols-12 gap-fluid-twenty border-t border-black/10 pt-fluid-forty font-normal tracking-[-3%] text-black"
    >
        <SplitReveal
            class="col-span-12 pt-fluid-eighty pb-fluid-270 text-footer leading-[115%] md:col-span-8 md:pt-0 md:pb-0"
        >
            {
                headlineLines.map((line, i) => (
                    <>
                        {i > 0 && <br />}
                        {line}
                    </>
                ))
            }
        </SplitReveal>
        <form
            id="contact-form"
            class="col-span-12 flex flex-col justify-start gap-fluid-ten leading-[120%] md:col-span-4"
            action="https://api.web3forms.com/submit"
            method="POST"
        >
            <input type="hidden" name="access_key" value="1eafa823-ab11-4e6e-9dec-ec22f75c228c" />
            <label for="name" class="block text-body-sm font-medium opacity-75">
                {form?.nameLabel}
            </label>
            <input
                type="text"
                class="mb-5 w-full border-b border-black pt-3 pr-4 pb-3 pl-4 text-sm font-medium outline-0"
                name="name"
                placeholder="Name"
                required
            />
            <label for="email" class="block text-body-sm font-medium opacity-75">
                {form?.emailLabel}
            </label>
            <input
                type="email"
                name="email"
                class="mb-5 w-full border-b border-black pt-3 pr-4 pb-3 pl-4 text-sm font-medium outline-0"
                placeholder="Email"
                required
            />
            <label for="message" class="block text-body-sm font-medium opacity-75">
                {form?.messageLabel}
            </label>
            <textarea
                name="message"
                rows="3"
                class="mb-5 w-full border-b border-black pt-3 pr-4 pb-3 pl-4 text-sm font-medium outline-0"
                placeholder="Message"
                required></textarea>
            <div class="h-fit w-full">
                <Button class="h-fit w-fit text-body-sm leading-[100%] font-medium" type="submit"
                    >{form?.submitLabel}</Button
                >
            </div>
        </form>
    </div>
    <div class="grid h-fit grid-cols-12">
        <div
            class="col-span-6 flex flex-row items-center gap-fluid-forty tracking-[-1%] md:col-span-4"
        >
            <h3 class="pt-1 text-body-sm">Email</h3>
            <SplitRevealColour color="#ff922d" class="text-body-lg leading-[120%]"
                >{email}</SplitRevealColour
            >
        </div>
        <div
            class="col-span-6 flex flex-row items-center gap-fluid-forty tracking-[-1%] md:col-span-4"
        >
            <h3 class="pt-1 text-body-sm">Phone</h3>
            <SplitRevealColour color="#ff922d" class="z-10 text-body-lg leading-[120%]" tag="p"
                >{phone}</SplitRevealColour
            >
        </div>
    </div>
</div>
